# OpenWA — contoh konfigurasi. Salin ke .env lalu sesuaikan.
#   cp .env.example .env

# Versi image (pin, jangan :latest). Tag ghcr.io TIDAK memakai prefix "v".
OPENWA_VERSION=0.30.1

# Port host (hanya dipublikasikan ke 127.0.0.1 oleh compose)
API_PORT=2785
LOG_LEVEL=info

# Batas resource container (compose only)
OPENWA_MEM_LIMIT=1500m
OPENWA_PIDS_LIMIT=1024

# Engine WhatsApp:
#   whatsapp-web.js  -> risiko ban lebih rendah, RAM ±300–500 MB/sesi (rekomendasi untuk VPS 6 GB)
#   baileys          -> RAM ±30–80 MB/sesi, tetapi lebih mudah di-fingerprint WhatsApp
ENGINE_TYPE=baileys

# Hidupkan kembali sesi yang sudah terautentikasi saat container restart
AUTO_START_SESSIONS=true

# Anti-ban: simulasikan mengetik + batas kirim harian per umur sesi
SIMULATE_TYPING=true
SIMULATE_TYPING_MAX_MS=5000
SEND_PACING_ENABLED=true
SEND_PACING_WARMUP_SCHEDULE=20,40,80,160,320,640,1000
SEND_PACING_COLD_DAILY_CAP=5,10,20,40,60,80,100
SEND_PACING_BREAKER_THRESHOLD=5
SEND_PACING_BREAKER_COOLDOWN_MS=900000

# SQLite (default, cukup untuk 1 sesi). Biarkan kosong untuk pakai PostgreSQL.
DATABASE_TYPE=sqlite
