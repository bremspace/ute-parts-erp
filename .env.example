APP_NAME="Ute Parts"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@uteparts.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =====================================================================
# Ute Parts — Integrasi Eksternal (PRD §4.7, §4.8, §4.10)
# Semua sandbox HANYA setelah UAT; produksi ganti key real.
# =====================================================================

# --- Duitku Payment Gateway (§4.7) ---
# Sandbox key default; set false + key produksi setelah UAT
DUITKU_SANDBOX=true
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_MERCHANT_KEY=
DUITKU_SANDBOX_URL=https://sandbox.duitku.com/webapi/api/merchant
DUITKU_PRODUCTION_URL=https://api.duitku.com/webapi/api/merchant
DUITKU_EXPIRY_PERIOD=1440

# --- Biteship Shipping (§4.8) ---
BITESHIP_API_KEY=
BITESHIP_BASE_URL=https://api.biteship.com/v1

# --- Shopee Open API — Omnichannel MVP (§4.10) ---
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=

# --- WA Gateway (§4.9) — pilih satu provider: Fonnte / Wablas / WA Business API ---
# WA_GATEWAY_URL=
# WA_GATEWAY_TOKEN=
# WA_GATEWAY_DEVICE_ID=
