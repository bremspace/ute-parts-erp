APP_NAME="UTEParts"
APP_ENV=production
APP_KEY={{APP_KEY}}
APP_DEBUG=false
APP_URL={{APP_URL}}
APP_TIMEZONE={{TIMEZONE}}

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE={{DB_NAME}}
DB_USERNAME={{DB_USER}}
DB_PASSWORD={{DB_PASS}}

BROADCAST_DRIVER=log
CACHE_STORE=redis
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_CONNECTION=cache
# Akses IP memakai HTTP, jadi cookie tidak boleh Secure, kalau tidak CSRF 419.
# Domain tetap dipaksa HTTPS lewat HSTS + redirect Nginx.
SESSION_SECURE_COOKIE=false

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD={{REDIS_PASS}}
REDIS_PORT=6379
REDIS_DB=2
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@{{DOMAIN}}"
MAIL_FROM_NAME="${APP_NAME}"

# Fallback gateway WA (nilai utama disimpan di tabel konfigurasi aplikasi)
WA_GATEWAY_URL=
WA_GATEWAY_TOKEN=
WA_GATEWAY_DEVICE_ID=
WA_OPENWA_URL=http://127.0.0.1:2785/api
WA_OPENWA_API_KEY=
WA_OPENWA_SESSION=
WA_OPENWA_TIMEOUT=20

# Upload backup/restore via UI (Livewire) — hingga 2GB
LIVEWIRE_UPLOAD_MAX_KB=2048000
LIVEWIRE_PAYLOAD_MAX_SIZE=2306867200
LIVEWIRE_UPLOAD_MAX_MINUTES=120

VITE_APP_NAME="${APP_NAME}"
