# =============================================================================
# UTE PARTS ERP — TEMPLATE .env.client (dipakai DI DALAM IMAGE)
# =============================================================================
# File ini sengaja TIDAK mengandung rahasia. Nilai asli berada di
# installers/docker-client/.env.client (dibuat wizard, dibaca compose sbg env_file).
# Entry point menyalin template ini ke storage/.env sekali saat pertama start,
# lalu APP_KEY dihasilkan otomatis. Environment variable dari compose
# (env_file .env.client) selalu menang atas nilai default di bawah.
# =============================================================================

APP_NAME="UTE PARTS ERP - CLIENT"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database lokal milik node client (container mysql pada compose yang sama)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ute_parts_client
DB_USERNAME=ute_client
DB_PASSWORD=ute_client_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@uteparts.id"
MAIL_FROM_NAME="${APP_NAME}"
BREMSPACE_LICENSE_ENABLED=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Hybrid Sync — client offline-first yang menarik data kanonik dari cloud
# -----------------------------------------------------------------------------
SYNC_ENABLED=true
SYNC_NODE_ROLE=primary_store
SYNC_NODE_ID=STORE-01
SYNC_REMOTE_URL=https://uteparts.id
SYNC_API_SECRET=
SYNC_PULL_INTERVAL_SECONDS=30

# Penanda installer (dibaca entry point, BUKAN config/sync.php):
#   true  = client → TIDAK PERNAH menjalankan seeder apa pun
#   false = cloud  → tetap tidak menjalankan seeder di installer ini
SYNC_CLIENT_MODE=true

# Akun admin LOKAL untuk login awal. Dibuat sekali (idempoten) oleh entry point
#via perintah client:bootstrap-admin. BUKAN data seeder, BUKAN data master.
ADMIN_EMAIL=admin@uteparts.id
ADMIN_PASSWORD=
ADMIN_NAME="Admin Client"
ADMIN_BRANCH_CODE=CBG-01
ADMIN_BRANCH_NAME="Cabang Utama"
