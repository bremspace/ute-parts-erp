[Unit]
Description=Bremspace ERP & POS Standalone Local Server
After=network.target mariadb.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/bremspace-erp
ExecStart=/opt/bremspace-erp/bin/bremspace-erp.sh
Restart=always
RestartSec=5
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
