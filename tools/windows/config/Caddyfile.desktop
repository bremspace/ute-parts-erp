{
    admin off
    auto_https off
    log {
        output discard
    }
}

:{{APP_PORT}} {
    bind 127.0.0.1
    root * "{{APP_DIR}}/public"
    encode zstd gzip

    # FastCGI proxy to local PHP-CGI daemon
    php_fastcgi 127.0.0.1:{{CGI_PORT}}

    # Serve static assets directly
    file_server
}
