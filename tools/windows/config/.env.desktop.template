APP_NAME="Bremspace ERP"
APP_ENV=production
APP_KEY={{APP_KEY}}
APP_DEBUG=false
APP_URL=http://127.0.0.1:{{APP_PORT}}

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Database Configuration (Embedded MariaDB Portable)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT={{DB_PORT}}
DB_DATABASE=bremspace_db
DB_USERNAME=root
DB_PASSWORD=

# Session & Cache (Database local driver)
SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Desktop Runtime Specific Settings
BREMSPACE_RUNTIME=windows_desktop
BREMSPACE_LICENSE_PATH="{{LICENSE_PATH}}"
BREMSPACE_DATA_DIR="{{DATA_DIR}}"

# Notification & Outbox
NOTIFIKASI_DEFAULT_CHANNEL=log
MAIL_MAILER=log
