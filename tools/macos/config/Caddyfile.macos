{
    admin off
    auto_https off
    log {
        output discard
    }
}

:{$APP_PORT:1741} {
    bind 0.0.0.0
    root * "{$APP_DIR}/public"
    encode zstd gzip

    # FastCGI proxy ke PHP-FPM / FastCGI macOS Darwin
    php_fastcgi 127.0.0.1:{$CGI_PORT:9000}

    # Serve static assets directly
    file_server
}
